<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample Log4j 2 configuration for the fgl-log4j test app.
  Log4j 2 auto-discovers this file when it is on the CLASSPATH.
  Applications using fgl-log4j supply their own log4j2.xml the same way.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
